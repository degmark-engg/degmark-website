---
// Inner-page banner: navy with a photo behind, white title with amber underline.
import Breadcrumb from './Breadcrumb.astro';
import { photos, altFor } from '../data/images';
interface Props {
  title: string;
  lead?: string;
  crumbs?: { href?: string; label: string }[];
  chips?: string[];
  panel?: { eyebrow: string; text: string; href: string; label: string };
  image?: string;     // background photo (defaults to the site banner)
  product?: string;   // optional product photo shown on the right instead of the panel
}
const { title, lead, crumbs, chips, panel, image = photos.banner, product } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-navy-deep text-white">
  <img src={image} alt={altFor(image)} class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
  <div class="absolute inset-0 -z-10" style="background: linear-gradient(90deg, rgba(10,30,44,.97) 0%, rgba(10,30,44,.9) 45%, rgba(10,30,44,.6) 100%);"></div>
  <div class="absolute inset-0 -z-10 grid-bg opacity-70"></div>
  <div class="container-x py-12 sm:py-16 flex flex-wrap gap-10 items-center">
    <div class="flex-[999_1_560px] min-w-0">
      {crumbs && <Breadcrumb items={crumbs} dark />}
      <h1 class="title-bar !text-white !text-[34px] sm:!text-[50px] !leading-[1.06] tracking-[-0.02em]">{title}</h1>
      {lead && <p class="mt-6 text-[17px] sm:text-[18px] leading-relaxed text-on-navy max-w-[640px]">{lead}</p>}
      {chips && chips.length > 0 && <div class="flex flex-wrap gap-2 mt-6">{chips.map((c) => <span class="inline-flex items-center rounded-full border border-white/25 bg-white/[.06] text-white text-[13px] font-semibold px-3 py-1.5">{c}</span>)}</div>}
      <slot />
    </div>
    {product ? (
      <div class="flex-[1_1_280px] max-w-[380px] mx-auto">
        <div class="rounded-card bg-white/95 p-6 flex items-center justify-center aspect-square shadow-[0_24px_48px_-20px_rgba(0,0,0,.6)]"><img src={product} alt={altFor(product)} class="max-h-full max-w-full object-contain mix-blend-multiply" /></div>
      </div>
    ) : panel && (
      <aside class="flex-[1_1_280px] rounded-card p-6 bg-white/[.07] border border-white/15 backdrop-blur-sm">
        <div class="eyebrow text-amber">{panel.eyebrow}</div>
        <p class="text-on-navy mt-2 mb-4">{panel.text}</p>
        <a href={panel.href} class="btn-accent">{panel.label}</a>
      </aside>
    )}
  </div>
</section>
