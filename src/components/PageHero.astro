---
import Breadcrumb from './Breadcrumb.astro';
interface Props {
  title: string;
  lead?: string;
  crumbs?: { href?: string; label: string }[];
  chips?: string[];
  panel?: { eyebrow: string; text: string; href: string; label: string };
}
const { title, lead, crumbs, chips, panel } = Astro.props;
---
<section class="bg-surface border-b border-line">
  <div class="container-x py-10 flex flex-wrap gap-8 items-start">
    <div class="flex-[999_1_560px] min-w-0">
      {crumbs && <Breadcrumb items={crumbs} />}
      <h1>{title}</h1>
      {lead && <p class="lead mt-4">{lead}</p>}
      {chips && chips.length > 0 && <div class="flex flex-wrap gap-2 mt-5">{chips.map((c) => <span class="chip">{c}</span>)}</div>}
      <slot />
    </div>
    {panel && (
      <aside class="flex-[1_1_280px] bg-navy rounded-card p-6">
        <div class="eyebrow text-amber">{panel.eyebrow}</div>
        <p class="text-on-navy mt-2 mb-4">{panel.text}</p>
        <a href={panel.href} class="btn-accent">{panel.label}</a>
      </aside>
    )}
  </div>
</section>
