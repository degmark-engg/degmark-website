---
interface Props { q: string; a: string; }
const { q, a } = Astro.props;
---
<details class="card px-5 py-4 group">
  <summary class="cursor-pointer font-semibold text-[16px] list-none flex justify-between gap-4">{q}<span class="text-teal group-open:rotate-45 transition" aria-hidden="true">+</span></summary>
  <p class="mt-3 text-ink">{a}</p>
</details>
