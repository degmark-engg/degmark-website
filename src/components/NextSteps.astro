---
import { company } from '../data/site';
---
<aside class="flex-[1_1_280px] space-y-4">
  <div class="card p-6">
    <h2 class="!text-[20px] mb-3">What happens next</h2>
    <ol class="space-y-3 text-[15px] list-decimal pl-5">
      <li>We review your requirement and check model suitability.</li>
      <li>We confirm availability and delivery with the manufacturer.</li>
      <li>You receive a quotation by email within {company.responseTime}.</li>
    </ol>
  </div>
  <div class="bg-navy rounded-card p-6 text-on-navy text-[15px] space-y-1">
    <div class="eyebrow text-amber mb-2">Contact directly</div>
    <p>{company.phone}</p><p>{company.email}</p>
  </div>
</aside>
