---
import Icon from './Icon.astro';
import { photos, altFor } from '../data/images';
---
<section class="relative isolate overflow-hidden text-white">
  <img src={photos.tender} alt={altFor(photos.tender)} class="absolute inset-0 -z-20 h-full w-full object-cover" loading="lazy" />
  <div class="absolute inset-0 -z-10 bg-navy-deep/[.88]"></div>
  <div class="container-x py-16 lg:py-20 grid gap-8 lg:grid-cols-[1.4fr_1fr] items-center">
    <div class="reveal">
      <div class="eyebrow text-amber mb-3">Tenders and specifications</div>
      <h2 class="title-bar !text-white !text-[28px] sm:!text-[40px] !leading-[1.1]">Have a tender or specification?</h2>
      <p class="mt-6 text-[17px] text-on-navy max-w-[560px]">Upload your tender, specification or indent and we will match suitable instruments. Or send model numbers and quantities for a quotation.</p>
    </div>
    <div class="flex flex-wrap gap-3 lg:justify-end reveal">
      <a href="/upload-requirement/" class="btn-accent !px-7 !min-h-[52px] !text-[16px]"><Icon name="upload" size={18} class="" />Upload requirement</a>
      <a href="/request-a-quote/" class="btn-ghost-light !px-7 !min-h-[52px] !text-[16px]">Request a quote</a>
    </div>
  </div>
</section>
