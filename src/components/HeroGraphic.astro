---
// Hero illustration: a generic survey meter with probe reading a source, plus a gamma spectrum card.
// Original line drawing in the site palette, so no photography or licensing is needed.
const bars = Array.from({ length: 14 }, (_, i) => i);
---
<svg viewBox="0 0 540 440" class="w-full h-auto" role="img" aria-label="Illustration of a radiation survey meter with a detector probe measuring a source, and a gamma spectrum showing the Cs-137 peak at 662 keV">
  <style>
    .hg-pulse { transform-box: view-box; transform-origin: 488px 322px; animation: hgPulse 3.6s ease-out infinite; }
    .hg-pulse.d2 { animation-delay: 1.2s; } .hg-pulse.d3 { animation-delay: 2.4s; }
    .hg-blink { animation: hgBlink 1.4s steps(2, start) infinite; }
    @keyframes hgPulse { 0% { transform: scale(.25); opacity: .9; } 100% { transform: scale(2.6); opacity: 0; } }
    @keyframes hgBlink { to { visibility: hidden; } }
    @media (prefers-reduced-motion: reduce) { .hg-pulse, .hg-blink { animation: none; } .hg-pulse { opacity: .25; } }
  </style>

  <!-- field rings around the source -->
  <g fill="none" stroke="#4FC3CF">
    <circle cx="488" cy="322" r="70" stroke-opacity=".22" />
    <circle cx="488" cy="322" r="130" stroke-opacity=".14" stroke-dasharray="4 8" />
    <circle cx="488" cy="322" r="195" stroke-opacity=".09" />
    <circle cx="488" cy="322" r="40" class="hg-pulse" stroke-width="1.5" />
    <circle cx="488" cy="322" r="40" class="hg-pulse d2" stroke-width="1.5" />
    <circle cx="488" cy="322" r="40" class="hg-pulse d3" stroke-width="1.5" />
  </g>

  <!-- source: radiation trefoil -->
  <g transform="translate(488 322)">
    <circle r="40" fill="#0A1E2C" stroke="#F2B33D" stroke-opacity=".5" />
    <circle r="6.5" fill="#F2B33D" />
    <path fill="#F2B33D" d="M5.5 9.53L15.0 25.98A30 30 0 0 1 -15.0 25.98L-5.5 9.53A11 11 0 0 0 5.5 9.53ZM-11.0 0.0L-30.0 0.0A30 30 0 0 1 -15.0 -25.98L-5.5 -9.53A11 11 0 0 0 -11.0 0.0ZM5.5 -9.53L15.0 -25.98A30 30 0 0 1 30.0 -0.0L11.0 -0.0A11 11 0 0 0 5.5 -9.53Z" />
  </g>

  <!-- spectrum card -->
  <g transform="translate(300 34)">
    <rect width="210" height="138" rx="12" fill="#0A1E2C" stroke="#4FC3CF" stroke-opacity=".35" />
    <text x="16" y="26" fill="#C3D0DA" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1.5">GAMMA SPECTRUM</text>
    <circle cx="190" cy="22" r="4" fill="#4FC3CF" class="hg-blink" />
    <line x1="16" y1="118" x2="194" y2="118" stroke="#C3D0DA" stroke-opacity=".35" />
    <path d="M16 112 C40 70 52 84 66 96 S92 104 104 100 L118 96 C124 92 126 36 131 36 C136 36 138 92 144 98 L170 108 L194 112" fill="none" stroke="#4FC3CF" stroke-width="2" stroke-linejoin="round" />
    <path d="M16 112 C40 70 52 84 66 96 S92 104 104 100 L118 96 C124 92 126 36 131 36 C136 36 138 92 144 98 L170 108 L194 112 V118 H16 Z" fill="#4FC3CF" fill-opacity=".12" />
    <line x1="131" y1="36" x2="131" y2="118" stroke="#F2B33D" stroke-dasharray="3 3" />
    <text x="139" y="50" fill="#F2B33D" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600">Cs-137</text>
    <text x="139" y="64" fill="#C3D0DA" font-family="IBM Plex Mono, monospace" font-size="10">662 keV</text>
  </g>

  <!-- probe cable -->
  <path d="M282 318 C 310 318 306 322 336 322" fill="none" stroke="#4FC3CF" stroke-opacity=".6" stroke-width="3" stroke-linecap="round" />

  <!-- detector probe -->
  <g transform="translate(334 304)">
    <rect width="96" height="36" rx="8" fill="#173A52" stroke="#4FC3CF" stroke-opacity=".5" />
    <rect x="10" y="8" width="8" height="20" rx="2" fill="#0A1E2C" />
    <rect x="22" y="8" width="8" height="20" rx="2" fill="#0A1E2C" />
    <rect x="92" y="-4" width="20" height="44" rx="6" fill="#173A52" stroke="#4FC3CF" stroke-opacity=".5" />
    <rect x="110" y="2" width="4" height="32" rx="2" fill="#4FC3CF" />
  </g>

  <!-- survey meter -->
  <g transform="translate(58 96)">
    <path d="M38 60 V30 a14 14 0 0 1 14 -14 H178 a14 14 0 0 1 14 14 V60" fill="none" stroke="#173A52" stroke-width="16" stroke-linecap="round" />
    <path d="M38 60 V30 a14 14 0 0 1 14 -14 H178 a14 14 0 0 1 14 14 V60" fill="none" stroke="#4FC3CF" stroke-opacity=".35" stroke-width="1" />
    <rect x="0" y="56" width="230" height="270" rx="24" fill="#173A52" stroke="#4FC3CF" stroke-opacity=".45" />
    <rect x="18" y="76" width="194" height="128" rx="10" fill="#06141D" stroke="#4FC3CF" stroke-opacity=".3" />
    <text x="34" y="100" fill="#C3D0DA" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1.5">DOSE RATE</text>
    <text x="196" y="100" text-anchor="end" fill="#F2B33D" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600">γ</text>
    <text x="32" y="150" fill="#4FC3CF" font-family="IBM Plex Mono, monospace" font-size="42" font-weight="600">0.142</text>
    <text x="196" y="122" text-anchor="end" fill="#C3D0DA" font-family="IBM Plex Mono, monospace" font-size="12">µSv/h</text>
    {bars.map((i) => (
      <rect x={34 + i * 12.2} y={186 - (6 + i * 1.4)} width="8" height={6 + i * 1.4} rx="1.5" fill={i < 8 ? '#4FC3CF' : '#4FC3CF'} fill-opacity={i < 8 ? 1 : 0.18} />
    ))}
    <circle cx="62" cy="248" r="16" fill="#0A1E2C" stroke="#4FC3CF" stroke-opacity=".4" />
    <circle cx="115" cy="248" r="16" fill="#0A1E2C" stroke="#F2B33D" stroke-opacity=".7" />
    <circle cx="115" cy="248" r="5" fill="#F2B33D" />
    <circle cx="168" cy="248" r="16" fill="#0A1E2C" stroke="#4FC3CF" stroke-opacity=".4" />
    <g stroke="#4FC3CF" stroke-opacity=".3" stroke-linecap="round" stroke-width="2.5">
      <line x1="80" y1="292" x2="150" y2="292" /><line x1="80" y1="302" x2="150" y2="302" />
    </g>
  </g>
</svg>
