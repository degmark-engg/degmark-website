---
import { company } from '../data/site';
import { isPlaceholder } from '../lib/series';
const contacts = [company.phone, company.email].filter((v) => !isPlaceholder(v));
---
<div class="bg-navy-deep text-on-navy-muted text-[13px] border-b border-white/5">
  <div class="container-x flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
    <span class="hidden sm:inline">{company.tagline}</span>
    <span class="flex gap-4 items-center">
      {contacts.map((c) => <span>{c}</span>)}
      <a href="/upload-requirement/" class="text-amber no-underline hover:text-white font-semibold">Upload a tender →</a>
    </span>
  </div>
</div>
