---
import { company, footerNav } from '../data/site';
---
<footer class="bg-navy text-on-navy">
  <div class="container-x py-10 grid gap-8 md:grid-cols-3">
    <div>
      <div class="text-white font-bold tracking-[0.06em] text-[18px]">{company.name.toUpperCase()}</div>
      <p class="mt-2 text-[14px] text-on-navy-muted">{company.tagline}</p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-2 text-[15px]">
      {footerNav.map((n) => <a href={n.href} class="text-on-navy no-underline hover:text-white">{n.label}</a>)}
    </nav>
    <div class="text-[14px] space-y-1">
      <p>{company.address}</p>
      <p>{company.phone}</p>
      <p>{company.email}</p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x py-4 text-[13px] text-on-navy-muted">© {new Date().getFullYear()} {company.name}. All rights reserved.</div>
  </div>
</footer>
