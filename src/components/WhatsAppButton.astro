---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { company } from '../data/site';
---
<a href={company.whatsapp} target="_blank" rel="noopener" class="wa-float fixed z-40 bottom-5 right-5 sm:bottom-6 sm:right-6 inline-flex items-center gap-2 rounded-full bg-[#25D366] text-white no-underline hover:text-white shadow-[0_10px_30px_-8px_rgba(0,0,0,.45)] h-14 w-14 sm:w-auto sm:pl-4 sm:pr-5 justify-center hover:brightness-105 transition" aria-label={`Chat with DEGMARK on WhatsApp: ${company.phone}`}>
  <WhatsAppIcon size={28} />
  <span class="hidden sm:inline font-semibold text-[15px]">WhatsApp us</span>
</a>
