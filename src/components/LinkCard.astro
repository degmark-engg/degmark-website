---
import Icon from './Icon.astro';
interface Props { href: string; title: string; text?: string; icon?: string; cta?: string; compact?: boolean; }
const { href, title, text, icon, cta = 'View range →', compact = false } = Astro.props;
---
<a href={href} class="card p-5 no-underline text-ink hover:text-ink hover:border-teal hover:shadow-sm transition flex flex-col gap-2">
  {icon && !compact && <Icon name={icon} />}
  <h3 class:list={['text-ink', compact ? 'text-[16px]' : 'text-[18px]']}>{title}</h3>
  {text && <p class="text-[14px] text-muted">{text}</p>}
  <slot />
  <span class="link-arrow mt-auto pt-1">{cta}</span>
</a>
