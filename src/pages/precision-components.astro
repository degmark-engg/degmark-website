---
// Division hub: precision mechanical components (PIC Design and other makers).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import LinkCard from '../components/LinkCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import Icon from '../components/Icon.astro';
import EnquiryStrip from '../components/EnquiryStrip.astro';
import { categoriesIn } from '../data/categories';
import { brandBySlug } from '../data/brands';
import { allSeries } from '../lib/series';
import { modelsInCategory, countLabel, categoryImage } from '../lib/stats';

const cats = categoriesIn('precision');
const slugs = new Set(cats.map((c) => c.slug));
const list = allSeries.filter((s) => slugs.has(s.category));
const pic = brandBySlug('pic-design')!;

const reasons = [
  ['Exact replacement parts', 'Many instruments, positioners and test rigs were built with catalogue precision components. Send the part number, an old BOM, a drawing or a photo and we will identify the matching part.'],
  ['Small quantities, properly documented', 'One gear or a full bill of materials. We handle import, documentation and tender requirements, including GeM and institutional purchase procedures.'],
  ['US-made precision', 'Fine-pitch gears, reducers and motion components from PIC Design, a division of RBC Bearings, in inch and metric sizes.'],
  ['One supplier for the whole mechanism', 'Gears, reducers, belts, slides, couplings, shafts and bearings sourced together, so your drawings and parts list go to a single point of contact.'],
];
const users = [
  ['atom', 'Research and atomic energy workshops', 'Instrument drives, sample changers, positioning and shielding mechanisms.'],
  ['shield', 'Defence and aerospace', 'Optical, antenna, gimbal and pan-tilt drives that need low backlash.'],
  ['flask', 'Laboratories and universities', 'Experimental set-ups, stages and test fixtures.'],
  ['component', 'Instrument makers and OEMs', 'Precision gear trains and motion components for new equipment.'],
];
---
<Base title="Precision Mechanical Components" description="Precision gears, speed reducers, belts and pulleys, linear motion components, couplings, shafting and bearings from PIC Design (RBC Bearings) and other manufacturers, with part-number matching for replacement parts.">
  <PageHero
    title="Precision Mechanical Components"
    lead="Fine-pitch gears, speed reducers, linear motion, couplings and bearings for instruments, positioning systems and laboratory equipment, sourced from PIC Design and other international manufacturers."
    crumbs={[{ href: '/products/', label: 'Products' }, { label: 'Precision Components' }]}
    chips={['Inch', 'Metric', 'Replacement parts', 'Small quantities']}
    panel={{ eyebrow: 'Have a part number?', text: 'Send a part number, drawing, old BOM or photo of the part and we will identify a match.', href: '/upload-requirement/', label: 'Send part details' }}
  />

  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow="Division 2" title="Product categories" lead="Key product families listed. Other parts, sizes and custom components are available on request." />
      <div class="grid-cards">
        {cats.map((c) => <LinkCard href={`/products/${c.slug}/`} title={c.name} text={c.short} icon={c.icon} image={categoryImage[c.slug]} badge={countLabel(modelsInCategory(c.slug))} />)}
      </div>
    </div>
  </section>

  <section class="section bg-surface border-y border-line">
    <div class="container-x">
      <SectionHead eyebrow="Why source through DEGMARK" title="Precision parts, sourced the way institutions buy" />
      <ul class="grid gap-x-10 gap-y-7 md:grid-cols-2">
        {reasons.map(([t, d], i) => (
          <li class="reveal">
            <div class="flex items-center gap-3"><span class="font-mono text-[12px] font-semibold text-teal">0{i + 1}</span><span class="h-px flex-1 bg-line"></span></div>
            <h3 class="mt-2 text-[18px] text-navy">{t}</h3>
            <p class="mt-1 text-[15px] text-ink-soft">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow="Who uses them" title="Where these components go" />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {users.map(([icon, t, d]) => (
          <li class="card p-5 reveal">
            <span class="w-11 h-11 rounded-btn bg-teal-tint flex items-center justify-center"><Icon name={icon} size={24} /></span>
            <h3 class="mt-3 text-[17px] text-navy">{t}</h3>
            <p class="mt-1 text-[14px] text-muted">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {list.length > 0 && (
    <section class="section pt-0">
      <div class="container-x">
        <SectionHead eyebrow="Series" title="PIC Design series" href={`/brands/${pic.slug}/`} linkText="About PIC Design →" />
        <div class="grid-cards">{list.map((s) => <SeriesCard series={s} />)}</div>
      </div>
    </section>
  )}

  <section class="section pt-0">
    <div class="container-x">
      <div class="rounded-card bg-navy grid-bg p-7 lg:p-9 flex flex-wrap items-center justify-between gap-6 text-on-navy">
        <div class="max-w-[640px]">
          <div class="eyebrow text-amber">Part-number matching</div>
          <h2 class="!text-white mt-2 !text-[24px] sm:!text-[28px]">Replacing a part in older equipment?</h2>
          <p class="mt-2">Send whatever you have: the part number stamped on the part, the equipment's parts list, a drawing, or a photo with key dimensions. We will identify the part or a suitable equivalent and quote.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/upload-requirement/" class="btn-accent">Send part details</a>
          <a href="/request-a-quote/" class="btn-ghost-light">Request a quote</a>
        </div>
      </div>
    </div>
  </section>
  <EnquiryStrip />
</Base>
