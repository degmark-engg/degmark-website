---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FormShell from '../components/FormShell.astro';
import FormField from '../components/FormField.astro';
import { company } from '../data/site';
---
<Base title="Contact" description="Contact DEGMARK Engineering Co. for radiation detection and measurement instruments.">
  <PageHero title="Contact us" lead="For quotations, use Request a Quote. For anything else, write to us here." crumbs={[{ label: 'Contact' }]} />
  <section class="section"><div class="container-x flex flex-wrap gap-6 items-start">
    <div class="flex-[1_1_300px] card p-6 space-y-4 text-[15px]">
      <div><div class="text-[13px] font-semibold uppercase text-muted">Address</div><p>{company.address}</p></div>
      <div><div class="text-[13px] font-semibold uppercase text-muted">Phone</div><p>{company.phone}</p></div>
      <div><div class="text-[13px] font-semibold uppercase text-muted">Email</div><p>{company.email}</p></div>
      <div><div class="text-[13px] font-semibold uppercase text-muted">Hours</div><p>{company.hours}</p></div>
    </div>
    <div class="flex-[999_1_480px] min-w-0">
      <FormShell type="contact" submit="Send message">
        <div class="grid gap-4 sm:grid-cols-2">
          <FormField label="Name" name="name" required autocomplete="name" />
          <FormField label="Email" name="email" type="email" required autocomplete="email" />
        </div>
        <FormField label="Organisation" name="organisation" autocomplete="organization" />
        <FormField label="Message" name="message" textarea required />
      </FormShell>
    </div>
  </div></section>
</Base>
