---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LinkCard from '../../components/LinkCard.astro';
import EnquiryStrip from '../../components/EnquiryStrip.astro';
import { articles } from '../../data/resources';
const items = [
  ['catalogues', 'Catalogues', 'Product catalogues from our principals.', 'book'],
  ['datasheets', 'Datasheets', 'Technical datasheets for listed models.', 'document'],
  ['manuals', 'Manuals', 'Operating manuals, where the manufacturer permits.', 'document'],
  ['technical-articles', 'Technical articles', 'Guides to radiation measurement and instrument selection.', 'article'],
  ['faqs', 'FAQs', 'Ordering, delivery, documentation and technical questions.', 'question'],
];
---
<Base title="Resources" description="Catalogues, datasheets, manuals, technical articles and FAQs for radiation detection and measurement instruments.">
  <PageHero title="Resources" lead="Documents and guidance for selecting and using radiation instruments." crumbs={[{ label: 'Resources' }]} />
  <section class="section"><div class="container-x grid-cards">
    {items.map(([s, t, d, i]) => <LinkCard href={`/resources/${s}/`} title={t} text={d} icon={i} cta="Open →" />)}
  </div></section>
  {articles.length > 0 && (
    <section class="section pt-0"><div class="container-x"><h2 class="mb-5">Latest articles</h2>
      <div class="grid-cards">{articles.slice(0, 3).map((a) => <LinkCard compact href={`/resources/technical-articles/${a.slug}/`} title={a.title} text={a.summary} cta="Read →" />)}</div>
    </div></section>
  )}
  <EnquiryStrip />
</Base>
