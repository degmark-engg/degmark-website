---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LinkCard from '../../components/LinkCard.astro';
import { categoryImage, modelsInCategory, countLabel } from '../../lib/stats';
import SeriesCard from '../../components/SeriesCard.astro';
import DownloadRow from '../../components/DownloadRow.astro';
import OnRequestNote from '../../components/OnRequestNote.astro';
import EnquiryStrip from '../../components/EnquiryStrip.astro';
import { brands, type Brand } from '../../data/brands';
import { categories } from '../../data/categories';
import { downloads } from '../../data/resources';
import { seriesForBrand } from '../../lib/series';

export function getStaticPaths() {
  return brands.map((b) => ({ params: { brand: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: Brand };
const list = seriesForBrand(b.name);
const cats = categories.filter((c) => list.some((s) => s.category === c.slug));
const docs = downloads.filter((d) => d.brand === b.name);
---
<Base title={b.name} description={`${b.name} (${b.country}): ${b.oneLine}`}>
  <PageHero title={b.name} lead={b.oneLine} crumbs={[{ href: '/brands/', label: 'Brands' }, { label: b.name }]} chips={[b.country]}>
    {b.logo && <img src={b.logo} alt={`${b.name} logo`} class:list={['max-h-12 mt-6', b.logoOnDark !== 'original' && 'logo-white']} />}
  </PageHero>
  <section class="section">
    <div class="container-x prose-x">
      <h2>About {b.name}</h2>
      {b.about.map((p) => <p class="mt-3">{p}</p>)}
    </div>
  </section>
  {cats.length > 0 && (
    <section class="section pt-0"><div class="container-x"><h2 class="title-bar mb-7">Product categories</h2>
      <div class="grid-cards">{cats.map((c) => <LinkCard href={`/products/${c.slug}/`} title={c.name} text={c.short} icon={c.icon} image={categoryImage[c.slug]} badge={countLabel(modelsInCategory(c.slug))} />)}</div>
    </div></section>
  )}
  <section class="section pt-0">
    <div class="container-x space-y-5">
      <h2>{b.name} series</h2>
      {list.length > 0 ? <div class="grid-cards">{list.map((s) => <SeriesCard series={s} />)}</div> : <p class="text-ink-soft">Series for {b.name} are being prepared.</p>}
      <OnRequestNote text={`Other ${b.slug === 'other-manufacturers' ? '' : b.name + ' '}models are available on request.`} />
    </div>
  </section>
  {docs.length > 0 && (
    <section class="section pt-0"><div class="container-x"><h2 class="title-bar mb-7">Catalogues and datasheets</h2>
      <ul class="card">{docs.map((d) => <DownloadRow item={d} />)}</ul>
    </div></section>
  )}
  <EnquiryStrip />
</Base>
