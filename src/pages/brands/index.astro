---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import EnquiryStrip from '../../components/EnquiryStrip.astro';
import { brands } from '../../data/brands';
import { modelsForBrand, countLabel } from '../../lib/stats';
---
<Base title="Brands" description="International manufacturers of radiation detection and measurement equipment represented by DEGMARK: LND, ATOMTEX, STAPLEX, Gamma-Scout, Arrow-Tech and others.">
  <PageHero title="Brands" lead="We represent established manufacturers of radiation detection and measurement equipment, and source from other international makers on request." crumbs={[{ label: 'Brands' }]} />
  <section class="py-16 lg:py-20">
    <div class="container-x grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {brands.map((b) => (
        <a href={`/brands/${b.slug}/`} class="group card lift reveal p-6 no-underline text-ink hover:text-ink hover:border-teal flex flex-col gap-2 border-t-4 !border-t-navy hover:!border-t-amber">
          <div class="h-12 flex items-center">{b.logo ? <img src={b.logo} alt={b.name} class:list={['max-h-11 w-auto', b.logoOnLight === 'dark' && 'logo-dark-full']} /> : <span class="wordmark text-[22px] !tracking-[0.04em] text-navy">{b.name}</span>}</div>
          {b.slug !== 'other-manufacturers' && <span class="count-badge self-start">{countLabel(modelsForBrand(b.name))}</span>}
          <span class="text-[13px] text-muted">{b.country}</span>
          <p class="text-[14px] text-muted">{b.oneLine}</p>
          <span class="mt-auto pt-3 flex items-center justify-between text-[14px] font-semibold text-navy"><span class="border-b-2 border-amber pb-0.5">View products</span><span class="w-8 h-8 rounded-full bg-navy text-white flex items-center justify-center transition-colors group-hover:bg-amber group-hover:text-navy" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>
  <EnquiryStrip />
</Base>
