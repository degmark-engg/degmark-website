---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LinkCard from '../../components/LinkCard.astro';
import { categoryImage, modelsInCategory, countLabel } from '../../lib/stats';
import SeriesCard from '../../components/SeriesCard.astro';
import EnquiryStrip from '../../components/EnquiryStrip.astro';
import { applications, type Application } from '../../data/applications';
import { categories } from '../../data/categories';
import { seriesForApplication } from '../../lib/series';

export function getStaticPaths() {
  return applications.map((a) => ({ params: { application: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Application };
const cats = categories.filter((c) => a.categories.includes(c.slug));
const featured = seriesForApplication(a.slug).slice(0, 6);
---
<Base title={a.name} description={`${a.name}: ${a.intro}`.slice(0, 300)}>
  <PageHero title={a.name} lead={a.intro} crumbs={[{ href: '/applications/', label: 'Applications' }, { label: a.name }]} />
  <section class="section"><div class="container-x prose-x">
    <h2>What the measurement involves</h2>
    {a.body.map((p) => <p class="mt-3">{p}</p>)}
  </div></section>
  <section class="section pt-0"><div class="container-x">
    <h2 class="title-bar mb-7">Recommended product types</h2>
    <div class="grid-cards">{cats.map((c) => <LinkCard href={`/products/${c.slug}/`} title={c.name} text={c.short} icon={c.icon} image={categoryImage[c.slug]} badge={countLabel(modelsInCategory(c.slug))} />)}</div>
  </div></section>
  {featured.length > 0 && (
    <section class="section pt-0"><div class="container-x">
      <h2 class="title-bar mb-7">Featured series</h2>
      <div class="grid-cards">{featured.map((s) => <SeriesCard series={s} />)}</div>
    </div></section>
  )}
  <EnquiryStrip />
</Base>
