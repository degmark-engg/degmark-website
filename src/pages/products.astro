---
import Base from '../layouts/Base.astro';
import { brands, categories } from '../data/site';
const brandName = (slug: string) => brands.find((b) => b.slug === slug)?.name ?? slug;
---
<Base title="Products" description="Radiation detectors, GM tubes, survey meters, spectrometers, air samplers and dosimeters supplied by Degmark Engineering.">
  <section>
    <div class="wrap">
      <h1>Products</h1>
      <p class="lead">Instruments and components grouped by application. Tell us your requirement and we'll recommend the right model.</p>
      <div class="grid" style="margin-top:28px">
        {categories.map((c) => (
          <div class="card">
            <h3>{c.name}</h3>
            <p>{c.text}</p>
            <div>{c.brands.map((s) => <a class="tag" href={`/brands/${s}/`}>{brandName(s)}</a>)}</div>
          </div>
        ))}
      </div>
      <div class="actions"><a class="btn" href="/contact/">Request a quote</a></div>
    </div>
  </section>
</Base>
