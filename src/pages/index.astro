---
import Base from '../layouts/Base.astro';
import LinkCard from '../components/LinkCard.astro';
import SectionHead from '../components/SectionHead.astro';
import EnquiryStrip from '../components/EnquiryStrip.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/categories';
import { brands } from '../data/brands';
import { applications } from '../data/applications';
import { industries } from '../data/industries';
import { articles } from '../data/resources';
const principals = brands.filter((b) => b.slug !== 'other-manufacturers');
---
<Base description="DEGMARK supplies radiation detectors, survey meters, monitoring systems, air samplers, dosimeters and contamination monitors from leading international manufacturers.">
  <section class="bg-surface border-b border-line">
    <div class="container-x py-12 flex flex-wrap gap-8 items-center">
      <div class="flex-[999_1_560px]">
        <div class="eyebrow text-teal">Radiation detection · Monitoring · Measurement</div>
        <h1 class="mt-3">Radiation detection and measurement instruments from leading manufacturers</h1>
        <p class="lead mt-4">DEGMARK supplies detectors, survey meters, monitoring systems, air samplers, dosimeters and contamination monitors to nuclear, research, medical, industrial and environmental users.</p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="/products/" class="btn-primary">Explore products</a>
          <a href="/request-a-quote/" class="btn-secondary">Request a quote</a>
        </div>
      </div>
      <aside class="flex-[1_1_280px] bg-navy rounded-card p-6">
        <div class="eyebrow text-amber">Have a tender or specification?</div>
        <p class="text-on-navy mt-2 mb-4">Upload your tender, specification or indent and we will match suitable instruments.</p>
        <a href="/upload-requirement/" class="btn-accent">Upload requirement</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHead title="Product categories" href="/products/" linkText="All products →" />
      <div class="grid-cards">
        {categories.map((c) => <LinkCard href={`/products/${c.slug}/`} title={c.name} text={c.short} icon={c.icon} />)}
        <LinkCard href="/products/radiation-detectors/?subtype=GM%20tubes" title="Geiger-Müller (GM) Tubes" text="End-window, pancake, thin-wall, gamma and energy-compensated GM tubes." icon="detector" />
      </div>
    </div>
  </section>

  <section class="section bg-surface border-y border-line">
    <div class="container-x">
      <SectionHead title="Brands we represent" href="/brands/" linkText="All brands →" />
      <ul class="flex flex-wrap gap-3">
        {principals.map((b) => (
          <li><a href={`/brands/${b.slug}/`} class="card flex items-center justify-center min-w-[150px] h-16 px-6 no-underline text-navy font-bold tracking-[0.04em] hover:border-teal">
            {b.logo ? <img src={b.logo} alt={b.name} class="max-h-10" /> : b.name}
          </a></li>
        ))}
        <li><a href="/brands/other-manufacturers/" class="card flex items-center justify-center min-w-[150px] h-16 px-6 no-underline text-muted font-semibold hover:border-teal">+ Other manufacturers</a></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHead title="What do you need to measure?" href="/applications/" linkText="All applications →" />
      <div class="grid-cards">{applications.map((a) => <LinkCard compact href={`/applications/${a.slug}/`} title={a.name} text={a.question} cta="Learn more →" />)}</div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-x">
      <SectionHead title="Industries we serve" href="/industries/" linkText="All industries →" />
      <div class="grid-cards">{industries.map((i) => <LinkCard compact href={`/industries/${i.slug}/`} title={i.name} text={i.oneLine} cta="Learn more →" />)}</div>
    </div>
  </section>

  <section class="section bg-surface border-y border-line">
    <div class="container-x">
      <h2 class="mb-5">Why DEGMARK</h2>
      <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {[
          ['Established principals', 'Instruments and detectors from recognised international manufacturers.'],
          ['Technical selection', 'Help choosing the right instrument for the radiation type, range and application.'],
          ['Tender support', 'Responses to tenders, specifications and technical evaluation queries.'],
          ['Beyond the catalogue', 'Models not listed on the site are available on request.'],
        ].map(([t, d]) => (
          <li class="flex gap-3"><Icon name="check" size={24} /><div><h3 class="text-[16px]">{t}</h3><p class="text-[14px] text-muted mt-1">{d}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section">
      <div class="container-x">
        <SectionHead title="Technical articles" href="/resources/technical-articles/" />
        <div class="grid-cards">{articles.slice(0, 3).map((a) => <LinkCard compact href={`/resources/technical-articles/${a.slug}/`} title={a.title} text={a.summary} cta="Read →" />)}</div>
      </div>
    </section>
  )}

  <EnquiryStrip />
</Base>
