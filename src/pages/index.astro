---
import Base from '../layouts/Base.astro';
import { brands, categories, sectors } from '../data/site';
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Radiation detection · Nuclear instrumentation</div>
      <h1>Instruments, detectors and spares<br />for India's nuclear sector</h1>
      <p class="lead">Degmark Engineering imports and supplies radiation detection and measurement equipment from leading international manufacturers — and keeps installed systems running with replacements, compatible components and spares.</p>
      <div class="actions">
        <a class="btn" href="/contact/">Send an enquiry</a>
        <a class="btn ghost" href="/products/">View products</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>What we supply</h2>
      <div class="grid">
        {categories.map((c) => (
          <div class="card"><h3>{c.name}</h3><p>{c.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>Brands we represent</h2>
      <div class="grid">
        {brands.map((b) => (
          <a class="card" href={`/brands/${b.slug}/`}>
            <h3>{b.name}</h3>
            <p>{b.lines.slice(0, 2).join(' · ')}</p>
            <span class="tag">{b.origin}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Who we serve</h2>
      <div class="grid">
        {sectors.map((s) => (
          <div class="card"><h3>{s.name}</h3><p>{s.note}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>Replacing a detector or keeping an older system running?</h2>
      <p class="lead">Much of our work is sourcing exact replacements and compatible parts for instruments already installed at plants and laboratories. Send us the make, model or part number and we'll find it.</p>
      <div class="actions"><a class="btn" href="/spares/">Spares &amp; replacements</a></div>
    </div>
  </section>
</Base>
