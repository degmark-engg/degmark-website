---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import EnquiryStrip from '../../components/EnquiryStrip.astro';
import { industries } from '../../data/industries';
import { industryImage } from '../../lib/stats';
import { photos, altFor } from '../../data/images';
---
<Base title="Industries" description="Radiation detection and monitoring instruments for nuclear power, research, healthcare, NDT, environmental monitoring, defence and laboratories.">
  <PageHero title="Industries" lead="The instruments each sector typically uses for radiation protection and measurement." crumbs={[{ label: 'Industries' }]} image={photos.industriesBanner} />
  <section class="py-16 lg:py-20">
    <div class="container-x grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {industries.map((i) => (
        <a href={`/industries/${i.slug}/`} class="group reveal relative isolate overflow-hidden rounded-card aspect-[4/5] no-underline text-white hover:text-white">
          <img src={industryImage(i.slug)} alt={altFor(industryImage(i.slug))} class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.07]" loading="lazy" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-deep via-navy-deep/60 to-navy-deep/5"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <span class="block h-[3px] w-10 bg-amber mb-3 transition-all duration-300 group-hover:w-16"></span>
            <h2 class="!text-[20px] !text-white !leading-snug">{i.name}</h2>
            <p class="mt-1.5 text-[14px] text-on-navy leading-snug">{i.oneLine}</p>
            <span class="mt-3 inline-block text-[13.5px] font-semibold text-amber">Learn more →</span>
          </div>
        </a>
      ))}
      <a href="/contact/" class="reveal rounded-card aspect-[4/5] bg-teal p-6 flex flex-col no-underline text-white hover:text-white lift">
        <Icon name="question" size={34} class="text-amber" />
        <h2 class="mt-auto !text-[21px] !text-white">Sector not listed?</h2>
        <p class="mt-2 text-[14px] text-white/85">Tell us about your application and we will suggest suitable instruments.</p>
        <span class="mt-4 text-[14px] font-semibold text-amber">Talk to us →</span>
      </a>
    </div>
  </section>
  <EnquiryStrip />
</Base>
