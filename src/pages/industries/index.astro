---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LinkCard from '../../components/LinkCard.astro';
import EnquiryStrip from '../../components/EnquiryStrip.astro';
import { industries } from '../../data/industries';
---
<Base title="Industries" description="Radiation detection and monitoring instruments for nuclear power, research, healthcare, NDT, environmental monitoring, defence and laboratories.">
  <PageHero title="Industries" lead="The instruments each sector typically uses for radiation protection and measurement." crumbs={[{ label: 'Industries' }]} />
  <section class="section"><div class="container-x grid-cards">
    {industries.map((i) => <LinkCard href={`/industries/${i.slug}/`} title={i.name} text={i.oneLine} icon="industry" cta="Learn more →" />)}
  </div></section>
  <EnquiryStrip />
</Base>
